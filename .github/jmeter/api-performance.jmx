                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"history":[{"timestamp":1747900000,"netKg":13},{"timestamp":1747986400,"netKg":11},{"timestamp":1748072800,"netKg":9},{"timestamp":1748159200,"netKg":7},{"timestamp":1748245600,"netKg":5}],"capacityKg":13}</stringProp>
