PORT=3001

# ===== Firebase Admin SDK (opcional) =====
# Necessário apenas para a rota GET /api/history/stats ler dados reais.
# URL do Realtime Database:
FIREBASE_DATABASE_URL=https://seu-projeto.firebaseio.com

# Credencial: use UMA das opções abaixo.
# 1) JSON da service account em linha única:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# 2) Caminho para o arquivo JSON da service account:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
